	<property name="com.jaspersoft.studio.data.defaultdataadapter" value=""/>
	<parameter name="VAR_COMPANY_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="VAR_BATCH_ID" class="java.lang.String"/>
	<parameter name="LOGO_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/logos/"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[Select sh.id as batch_id, sh.batch_code, sh.receipt_date, sh.date_collected, sh.crm_customer_id,
sh.crm_unit_name, sh.sample_type_id, sh.reference_number, sh.[status], sh.[description],
sh.document_number, sh.importer_address, sh.reason_for_submission, sh.priority,
 sd.sample_code, sd.analysis_type_id, sd.id, r.sample_detail_id as sample_id, r.analyte_code, r.analyte_id, r.result, 
r.reporting_symbol, sd.sample_condition_id, sd.comments,
rhd.*, a.name as analyte_name, sd.main_body, sd.header_body
FROM sample_headers AS sh, sample_details AS sd,
results AS r, report_header_details AS rhd, 
analysis_elements AS ae,
analytes AS a
WHERE ($X{EQUAL,sh.id,VAR_BATCH_ID}) 
AND sh.id = sd.sample_header_id
AND (r.sample_header_id = sh.id AND r.sample_detail_id = sd.id)
AND (rhd.model_id = sh.id AND rhd.sample_header_id = sh.id)
AND (r.analysis_type_id = ae.analysis_type_id AND r.analyte_id = ae.analyte_id)
AND (r.analyte_id = a.id) ORDER BY sd.sample_code]]>
	</queryString>
