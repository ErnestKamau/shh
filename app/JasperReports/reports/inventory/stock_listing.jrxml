	</parameter>
	<parameter name="WHERE_CLAUSE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" WHERE created_at BETWEEN '"+$P{VAR_START_DATE} + "' AND '" + $P{VAR_END_DATE} + "' "]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[Select inventory_category_name, inventory_sub_category_code, inventory_sub_category_name, 
		inventory_store, 
inventory_store_slot, unit_type, SUM(stock_in) as stock_in,
SUM(stock_out) as stock_out, (SUM(stock_in) -
SUM(stock_out)) as current_stock from Inventory_Items_View
$P!{WHERE_CLAUSE}
GROUP BY inventory_category_name, inventory_sub_category_code, inventory_sub_category_name, 
inventory_store, inventory_store_slot, unit_type
order by inventory_store, inventory_store_slot, inventory_category_name, 
inventory_sub_category_name]]>
	</queryString>
