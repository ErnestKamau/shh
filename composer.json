{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2.0",
        "africastalking/africastalking": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1.1",
        "darkaonline/l5-swagger": "^11.0",
        "geekcom/phpjasper": "^3.3",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.0",
        "livewire/livewire": "^3.6",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^12.0",
        "minishlink/web-push": "^10.0",
        "orangehill/iseed": "^3.0",
        "owen-it/laravel-auditing": "^14.0",
        "pragmarx/google2fa-laravel": "^3.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "simplesoftwareio/simple-qrcode": "^4.1",
        "spatie/laravel-permission": "^7.3",
        "spatie/laravel-translation-loader": "^2.8",
        "symfony/expression-language": "^7.3",
        "tecnickcom/tcpdf": "^6.10"
    },
    "require-dev": {
        "kitloong/laravel-migrations-generator": "^7.3",
        "laravel/boost": "^1.2",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "bin-dir": "bin"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/audit_helpers.php",
            "app/Helpers/CurrencyHelper.php",
            "app/Helpers/BillingHelper.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "exclude-from-classmap": [
            "Modules/*/Database/Migrations/*"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
